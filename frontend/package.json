{
  "name": "@agenvas/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": "12.5.1"
  },
  "scripts": {
    "dev": "vite",
    "api:generate": "openapi-typescript ../contracts/openapi.yaml -o src/shared/api/schema.ts",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-theme-colors.mjs && node scripts/check-i18n.mjs && eslint . --max-warnings=0",
    "test": "node --test scripts/check-i18n.test.mjs && vitest run",
    "test:smart-edit-layout": "node e2e/smart-edit-dialog-browser.mjs",
    "test:media-preview": "node e2e/media-preview-browser.mjs",
    "test:video-hover": "node e2e/video-hover-browser.mjs",
    "test:media-function-parameters": "node e2e/media-function-parameters-browser.mjs",
    "test:runninghub-node-picker": "node e2e/runninghub-node-picker-browser.mjs",
    "test:i18n": "node --test scripts/check-i18n.test.mjs && vitest run src/shared/i18n/i18n.test.tsx src/features/canvas/VoiceLibrary.test.tsx src/features/settings/AutoDlWorkflowFields.test.tsx",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.103.2",
    "@xyflow/react": "12.11.6",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-markdown": "10.1.0",
    "react-router": "7.18.4",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "yet-another-react-lightbox": "3.32.2",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
