# Copy to .env for local Compose use. Fill both blank values before starting.
# Compose refuses missing or empty values. Do not commit real secrets.
AGENVAS_DB_PASSWORD=

# One-time administrator setup authority; use a unique random value of at least 24 characters.
AGENVAS_BOOTSTRAP_SECRET=

# Optional Compose resource ceilings. Increase for larger projects after measuring usage.
# AGENVAS_POSTGRES_MEMORY_LIMIT=768m
# AGENVAS_POSTGRES_CPUS=1.0
# AGENVAS_SERVER_MEMORY_LIMIT=1536m
# AGENVAS_SERVER_CPUS=2.0
# AGENVAS_WEB_MEMORY_LIMIT=256m
# AGENVAS_WEB_CPUS=0.5

# Optional candidate real-provider configuration. Keep Mock defaults until the selected
# LLM and ComfyUI models have passed real tool-call and media-generation tests.
# AGENVAS_LLM_MODE=configured
# AGENVAS_CREDENTIAL_MASTER_KEY=<base64-encoded-random-32-byte-key>
# AGENVAS_PROVIDER_MODE=comfyui
# AGENVAS_PROVIDER_CONFIG_VERSION=1
# AGENVAS_COMFYUI_ENDPOINT=http://<exact-reachable-private-IPv4>:8188
# AGENVAS_COMFYUI_IMAGE_CHECKPOINT=<installed-checkpoint-filename>
# AGENVAS_COMFYUI_VIDEO_ENABLED=false
# AGENVAS_COMFYUI_VIDEO_DIFFUSION_MODEL=<installed-model-filename>
# AGENVAS_COMFYUI_VIDEO_TEXT_ENCODER=<installed-encoder-filename>
# AGENVAS_COMFYUI_VIDEO_VAE=<installed-vae-filename>
# AGENVAS_COMFYUI_VIDEO_CLIP_VISION=<installed-clip-vision-filename>
# AGENVAS_SECURE_COOKIES=false

# Set true only when restoring an older backup. Inspect Task/Provider attempts and asset
# files before returning to normal mode; this freezes background jobs and project writes.
# AGENVAS_RECOVERY_MODE=true
