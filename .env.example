# Copy to .env for deployment (compose.yaml) or Mock development (compose.dev.yaml).
# Fill the database password and bootstrap secret before starting either stack.
# Compose refuses missing or empty values. Do not commit real secrets.
AGENVAS_DB_PASSWORD=

# One-time administrator setup authority; use a unique random value of at least 24 characters.
AGENVAS_BOOTSTRAP_SECRET=

# Optional Compose resource ceilings. Increase for larger projects after measuring usage.
# AGENVAS_POSTGRES_MEMORY_LIMIT=768m
# AGENVAS_POSTGRES_CPUS=1.0
# AGENVAS_SERVER_MEMORY_LIMIT=1536m
# AGENVAS_SERVER_CPUS=2.0
# AGENVAS_WEB_MEMORY_LIMIT=256m
# AGENVAS_WEB_CPUS=0.5

# Default deployment uses configured LLM/media modes and does not enable Mock generation.
# Configure actual providers in the administrator settings before generating content.
# Set a credential encryption key before saving cloud API keys; Mock development needs none.
AGENVAS_CREDENTIAL_MASTER_KEY=
# Use a Base64-encoded random 32-byte key; do not commit the actual value.
# Development Compose explicitly selects Mock modes, independent of these optional overrides.
# AGENVAS_LLM_MODE=configured
# AGENVAS_PROVIDER_MODE=configured
# Needed only to aim the LLM endpoint at http://127.0.0.1:PORT — that exact literal address,
# not "localhost". Private-range and proxy fake-ip answers need no switch.
# AGENVAS_LLM_ALLOW_LOOPBACK_HTTP=true
# Media connections and capabilities are configured by the administrator in the UI.
# Compose includes a pinned Depth Anything V2 Small INT8 ONNX. Override only when
# deliberately testing another compatible, trusted Small model file inside the server container.
# AGENVAS_DEPTH_MODEL=/opt/agenvas/models/depth-anything-v2-small-int8.onnx
# AGENVAS_SECURE_COOKIES=false

# Background schedulers run by default. Set false for a maintenance window or before
# restoring a backup, so workers stop picking up new work.
# AGENVAS_LLM_SCHEDULER_ENABLED=false

# Task lease must cover both one whole synchronous provider call and the client's own
# request timeout (5 minutes for both GPT Image and Google Nano Banana). A lease shorter
# than the call makes the finished image be reclassified as UNKNOWN and discarded; a lease
# shorter than the client timeout makes the immediate reason-coded classification fall back
# to the generic recovery code. The 30-minute default covers both.
# AGENVAS_TASK_LEASE_DURATION=PT30M

# Set true only when restoring an older backup. Inspect Task/Provider attempts and asset
# files before returning to normal mode; this freezes background jobs and project writes.
# AGENVAS_RECOVERY_MODE=true
